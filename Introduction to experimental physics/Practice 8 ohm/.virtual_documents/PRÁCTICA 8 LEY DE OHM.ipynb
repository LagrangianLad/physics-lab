import numpy as np
import matplotlib.pyplot as plt

Vb = np.array([4.80, 4.43, 3.98, 3.42, 2.91, 2.43, 1.96, 1.467, 0.944, 0.397, 
               -0.271, -0.971, -1.405, -1.91, -2.39, -2.92, -3.44, -3.91, -4.39, -4.88])

Ib_mA = np.array([55.8, 52.8, 49.3, 45.5, 41.6, 37.7, 33.6, 28.3, 23.3, 17.2, 
                  -14.79, -23.7, -28.2, -33.1, -37.3, -41.7, -45.7, -49.1, -52.5, -55.8])
Ib_A = Ib_mA / 1000.0


# R = V / I
R_bombilla = Vb / Ib_A
# Potencia P = V * I 
Potencia = np.abs(Vb * Ib_A)

Rb = [Vb[i]*Ib_A[i] for i in range(len(Vb))]

u_Vb = []
for v in Vb:
    res = 0.01 if (round(v*100, 4) % 1 == 0) else 0.001
    u_Vb.append(uB_digital(res))
u_Vb = np.array(u_Vb)

u_Ib = []
for i_val in Ib_mA:
    res = 0.1 if (round(i_val*10, 4) % 1 == 0) else 0.01
    u_Ib.append(uB_digital(res / 1000.0)) # Convertimos la incertidumbre a Amperios
u_Ib = np.array(u_Ib)

R_bombilla = np.abs(Vb / Ib_A)
Potencia = np.abs(Vb * Ib_A)

rel_err_sq = (u_Vb / np.abs(Vb))**2 + (u_Ib / np.abs(Ib_A))**2
u_Rb = R_bombilla * np.sqrt(rel_err_sq)
u_P = Potencia * np.sqrt(rel_err_sq)

print(f"{'V (V)':>8} | {'I (mA)':>8} | {'R (Ohms)':>9} | {'Potencia (W)':>12}")
print("-" * 50)
for v, i_ma, r, p in zip(Vb, Ib_mA, R_bombilla, Potencia):
    print(f"{v:>8.3f} | {i_ma:>8.2f} | {r:>9.2f} | {p:>12.4f}")


plt.figure(figsize=(8, 5))

plt.errorbar(Vb, Ib_mA, xerr=u_Vb, yerr=u_Ib*1000, fmt='o', color='blue', 
             ecolor='lightblue', elinewidth=1, capsize=2, label='Datos experimentales')

plt.axhline(0, color='black', linewidth=1)
plt.axvline(0, color='black', linewidth=1)
plt.title('Intensidad vs Voltaje')
plt.xlabel('Voltaje V (V)')
plt.ylabel('Intensidad I (mA)')
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend()
plt.show()


plt.figure(figsize=(8, 5))

# Usamos np.abs para los datos y sus ejes
plt.errorbar(np.abs(Vb), np.abs(Ib_mA), xerr=u_Vb, yerr=u_Ib*1000, fmt='o', 
             color='blue', ecolor='lightblue', elinewidth=1, capsize=2, label='Valores absolutos')

plt.title('Intensidad vs voltaje (Curva en Valores Absolutos)')
plt.xlabel('|V| (V)')
plt.ylabel('|I| (mA)')
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend()
plt.show()


plt.figure(figsize=(8, 5))

# Representamos R frente a P con sus respectivas incertidumbres
plt.errorbar(Potencia, R_bombilla, xerr=u_P, yerr=u_Rb, fmt='o', 
             color='blue', ecolor='lightblue', elinewidth=1, capsize=2, label='R = f(P)')

plt.title('Resistencia vs Potencia (suponiendo T ∝ IV)')
plt.xlabel('Potencia P (W)')
plt.ylabel('Resistencia R (Ω)')
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend()
plt.show()





V_d = np.array([
    0.612, 0.607, 0.602, 0.594, 0.588, 0.578, 0.566, 0.548, 0.516, 0.449,
    -0.498, -0.986, -1.444, -1.938, -2.47, -2.93, -3.46, -3.95, -4.50, -4.93
])

V_r = np.array([
    -4.34, -3.86, -3.42, -2.85, -2.40, -1.921, -1.435, -0.900, -0.406, -0.570,
    0.0, 0.01e-3, 0.01e-3, 0.02e-3, 0.0002, 0.0003, 0.0003, 0.0004, 0.0004, 0.0005
])

R_nominal = 1000 # R nominal coincide con la R medida

T_ambiente = 297 





def corriente_diodo_shockley(V, Is, n):
    k = 1.381e-23 
    e = 1.602e-19 
    V0 = (k * T_ambiente) / e
    exponente = np.clip(V / (n * V0), None, 700) 
    return Is * (np.exp(exponente) - 1)


from scipy.optimize import curve_fit

I_diodo = -V_r / R_nominal 
# Ajusto por mínimos cuadrados no lineales cuando la polaridad es directa porque si no
# no puedo calcular la matriz de covarianza y se queda "pillado" en el cero (porque en
# polaridad inversa, el voltaje es prácticamente cero y entonces scipy ajusta a
# f(Vd) = "Id"(Vd) = 0 )
mascara_directa = V_d > 0.4
V_fit = V_d[mascara_directa]
I_fit = I_diodo[mascara_directa]


parametros_optimos, matriz_covarianza = curve_fit(
    corriente_diodo_shockley, 
    V_fit, 
    I_fit, 
    p0=[1e-12, 1.5],
    bounds=([1e-15, 1.0], [1e-7, 2.5])
)

i_s, n = parametros_optimos
incertidumbres = np.sqrt(np.diag(matriz_covarianza))
un = incertidumbres[1]

print(f"n: {n:.3f} ± {un:.3f}")
print(f"Is: {i_s:.3e} A")


plt.figure(figsize=(10, 6))
plt.scatter(V_d, I_diodo, color='red', label='Datos experimentales')
voltaje_continuo_teorico = np.linspace(min(V_d), max(V_d), 500)
corriente_ajustada_teorica = corriente_diodo_shockley(voltaje_continuo_teorico, *parametros_optimos)

plt.plot(
    voltaje_continuo_teorico, 
    corriente_ajustada_teorica, 
    linestyle='--', 
    color='blue', 
    label=f'Ajuste Shockley (n={n:.2f})'
)

plt.axhline(0, color='black', linewidth=1)
plt.axvline(0, color='black', linewidth=1)
plt.xlabel('Voltaje en el diodo ($V_d$) (V)')
plt.ylabel('Corriente en el diodo ($I_d$) (A)')
plt.title('Curva I-V para el Diodo ')
plt.legend()
plt.grid(True, alpha=0.3)
plt.ylim(min(I_diodo)-0.0005, max(I_diodo)+0.0005) 
plt.show()



plt.figure(figsize=(10, 6))
mascara_positiva = I_diodo > 0
plt.scatter(V_d[mascara_positiva], I_diodo[mascara_positiva], 
            color='red', label='Datos experimentales (I > 0)')

v_rango_directa = np.linspace(0.1, max(V_d), 500)
i_teorica_log = corriente_diodo_shockley(v_rango_directa, *parametros_optimos)

plt.plot(v_rango_directa, i_teorica_log, linestyle='--', color='blue', 
         label=f'Ajuste Shockley (n={n:.2f})')
plt.yscale('log')
plt.xlabel('Voltaje en el diodo ($V_d$) [V]')
plt.ylabel('Corriente en el diodo ($I_d$) (A)')
plt.title('Curva I-V para el diodo (semilogarítmica)')
plt.grid(True, which="both", ls="-", alpha=0.3) # Rejilla más detallada para log
plt.legend()

plt.show()






