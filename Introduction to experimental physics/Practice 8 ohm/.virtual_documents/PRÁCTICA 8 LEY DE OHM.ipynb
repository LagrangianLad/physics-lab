lin_model = Model(Lineal)
data = RealData(V_total, I_total, sy = u_I_t)
odr = ODR(data, lin_model, beta0 = [0.,1.])
out = odr.run()
out.pprint()


fit_y = Lineal(out.beta, V_total)
plt.errorbar(V_total, I_total, yerr= u_I_t, linestyle = "None", marker = 'o', label = r"$u_V$")
