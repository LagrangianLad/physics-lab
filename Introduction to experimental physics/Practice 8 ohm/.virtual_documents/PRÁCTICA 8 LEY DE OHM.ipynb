import matplotlib.pyplot as plt
from scipy.odr import *
from scipy import stats


def Lineal(parameters, x): 
    A, B = parameters
    y = np.multiply(A, x) + B 
    return y

def uB_digital(res):
    return res/np.sqrt(12)

def uB (res):
    return res/np.sqrt(24)

def uA (s, N):
    return s/np.sqrt(N)

def u_combinada (u_a, u_b):
    return np.sqrt(pow(u_a, 2)+ pow(u_b, 2))

def imprimir (lista, unidades, titulo = ""):
    print(titulo)
    for i in range(len(lista)):
        print(f"{i+1} : {lista[i]} {unidades}")


#RESISTENCIA

V_positivo = [4.92, 4.47, 3.91, 3.46, 2.95, 2.48, 1.99, 1.396, 0.871, 0.422]
V_negativo = [-0.416, -0.902, -1.317, -1.821, -2.44, -2.95, -3.47, -3.93, -4.46, -4.92]
V_total = V_positivo + V_negativo

I_positiva = [4.94, 4.48, 3.92, 3.48, 2.96, 2.49, 1.99, 1.371, 0.872, 0.422] #mA
I_negativa = [-0.416, -0.902, -1.317, -1.822, -2.43, -2.94, -3.48, - 3.93, -4.46, -4.92]
I_total = I_positiva + I_negativa #mA

u_I_p = []
u_I_n = []

for i in I_positiva:
    if (i*100) % 1 == 0:
        u_I_p.append(uB_digital(0.01))
    else:
        u_I_p.append(uB_digital(0.001))
    
for i in I_negativa:
    if (i*100) % 1 == 0:
        u_I_n.append(uB_digital(0.01))
    else:
        u_I_n.append(uB_digital(0.001))

u_I_t = u_I_p + u_I_n


