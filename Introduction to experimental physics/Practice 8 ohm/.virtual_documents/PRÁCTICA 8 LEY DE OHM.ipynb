I = [55.8, 52.8, 49.3, 45.5, 41.6, 37.7, 33.6, 28.3, 23.3, 17.2, -14.79, -23.7, -28.2, -33.1, -37.3, -41.7, -45.7, - 49.1, - 52.5, -55.8]

R = [V[i]*I[i] for i in range(len(V))]
