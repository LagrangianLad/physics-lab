def siguiente(xi, xj, A, B, C):
    """xi = x_n, xj = x_n+1"""
    return -A* xj - B*xi + C

def calcular_sucesion(N, A, B, C, x0, x1):
    output_x = [x0, x1]
    for i in range(N-2):
        x_siguiente = siguiente(output_x[i], output_x[i+1], A, B, C)
        output_x.append( x_siguiente )
    return output_x

