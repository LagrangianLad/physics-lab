# Usamos N-1 porque ya tenemos 2 puntos y queremos llegar al paso N
c = (k / masa) * (delta**2)
for i in range(1, N):
    xsiguiente = (2 - c) * output[i] - output[i-1]
    output.append(xsiguiente)

# Salida (limitada para no inundar la consola)
